@model BLL.DTOs.DoctorDTO

<h2>Doctor Details</h2>

<table border="1" cellpadding="10" cellspacing="0">

    <tr>
        <th>ID</th>
        <td>@Model.Id</td>
    </tr>

    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>

    <tr>
        <th>Phone</th>
        <td>@Model.Phone</td>
    </tr>

    <tr>
        <th>Gender</th>
        <td>@Model.Gender</td>
    </tr>

    <tr>
        <th>Department</th>
        <td>@Model.DepartmentName</td>
    </tr>

    <tr>
        <th>Specialization</th>
        <td>@Model.Specialization</td>
    </tr>

    <tr>
        <th>Qualification</th>
        <td>@Model.Qualification</td>
    </tr>

    <tr>
        <th>Available Time</th>
        <td>
            @Model.AvailableFrom - @Model.AvailableTo
        </td>
    </tr>

    <tr>
        <th>Max Patients Per Day</th>
        <td>@Model.MaxPatientsPerDay</td>
    </tr>

</table>

<br />

<p>
    <a asp-action="Index">Back to List</a>
</p>