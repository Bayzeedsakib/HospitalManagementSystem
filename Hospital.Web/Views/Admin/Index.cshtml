@{
    ViewData["Title"] = "Admin Dashboard";
}

<div style="
    padding:30px;
    font-family:Arial;
    background-color:#f4f6f9;
    min-height:100vh;">

    <div style="
        background-color:white;
        padding:20px;
        border-radius:10px;
        box-shadow:0 0 10px rgba(0,0,0,0.1);">

        <h1 style="color:#2c3e50; margin-bottom:10px;">
            Admin Dashboard
        </h1>

        <p style="color:#555; font-size:16px;">
            Welcome to the Smart Hospital System Control Panel.
        </p>
    </div>

    <br />

    
    <div style="
        background-color:white;
        padding:20px;
        border-radius:10px;
        box-shadow:0 0 10px rgba(0,0,0,0.1);">

        <h2 style="color:#34495e;">
            System Overview
        </h2>

        <table style="
            width:100%;
            border-collapse:collapse;
            margin-top:15px;">

            <tr style="background-color:#2c3e50; color:white;">
                <th style="padding:12px;">Category</th>
                <th style="padding:12px;">Total</th>
            </tr>

            <tr>
                <td style="padding:12px; border-bottom:1px solid #ddd;">
                    Patients
                </td>

                <td style="padding:12px; border-bottom:1px solid #ddd;">
                    @ViewBag.TotalPatients
                </td>
            </tr>

            <tr style="background-color:#f9f9f9;">
                <td style="padding:12px; border-bottom:1px solid #ddd;">
                    Doctors
                </td>

                <td style="padding:12px; border-bottom:1px solid #ddd;">
                    @ViewBag.TotalDoctors
                </td>
            </tr>

            <tr>
                <td style="padding:12px; border-bottom:1px solid #ddd;">
                    Departments
                </td>

                <td style="padding:12px; border-bottom:1px solid #ddd;">
                    @ViewBag.TotalDepartments
                </td>
            </tr>

            <tr style="background-color:#f9f9f9;">
                <td style="padding:12px;">
                    Appointments
                </td>

                <td style="padding:12px;">
                    @ViewBag.TotalAppointments
                </td>
            </tr>

        </table>
    </div>

    <br />

    @* Actions *@
    <div style="
        background-color:white;
        padding:20px;
        border-radius:10px;
        box-shadow:0 0 10px rgba(0,0,0,0.1);">

        <h2 style="color:#34495e;">
            Quick Actions
        </h2>

        <div style="margin-top:20px;">

            <a asp-controller="Patient"
               asp-action="Index"
               style="
                    display:inline-block;
                    margin:8px;
                    padding:10px 18px;
                    background-color:#3498db;
                    color:white;
                    text-decoration:none;
                    border-radius:5px;">

                Manage Patients
            </a>

            <a asp-controller="Doctor"
               asp-action="Index"
               style="
                    display:inline-block;
                    margin:8px;
                    padding:10px 18px;
                    background-color:#27ae60;
                    color:white;
                    text-decoration:none;
                    border-radius:5px;">

                Manage Doctors
            </a>

            <a asp-controller="Department"
               asp-action="Index"
               style="
                    display:inline-block;
                    margin:8px;
                    padding:10px 18px;
                    background-color:#f39c12;
                    color:white;
                    text-decoration:none;
                    border-radius:5px;">

                Manage Departments
            </a>

            <a asp-controller="Appointment"
               asp-action="Index"
               style="
                    display:inline-block;
                    margin:8px;
                    padding:10px 18px;
                    background-color:#8e44ad;
                    color:white;
                    text-decoration:none;
                    border-radius:5px;">

                Manage Appointments
            </a>

            <a asp-controller="Auth"
               asp-action="Logout"
               style="
                    display:inline-block;
                    margin:8px;
                    padding:10px 18px;
                    background-color:#e74c3c;
                    color:white;
                    text-decoration:none;
                    border-radius:5px;">

                Logout
            </a>

        </div>
    </div>

</div>