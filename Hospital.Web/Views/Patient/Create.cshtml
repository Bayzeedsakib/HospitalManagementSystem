@model BLL.DTOs.PatientDTO

<h2>Add Patient</h2>

<form method="post">

    <p>
        Name<br />
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </p>

    <p>
        Phone<br />
        <input asp-for="Phone" />
        <span asp-validation-for="Phone"></span>
    </p>

    <p>
        Email<br />
        <input asp-for="Email" />
    </p>

    <p>
        Gender<br />
        <select asp-for="Gender">
            <option>Male</option>
            <option>Female</option>
        </select>
    </p>

    <p>
        Date Of Birth<br />
        <input asp-for="DateOfBirth" type="date" />
    </p>

    <p>
        Blood Group<br />
        <input asp-for="BloodGroup" />
    </p>

    <p>
        Address<br />
        <textarea asp-for="Address"></textarea>
    </p>

    <button type="submit">Save</button>

</form>