@model List<BLL.DTOs.PatientDTO>

<h2>Patient List</h2>

@if (TempData["msg"] != null)
{
    <p>@TempData["msg"]</p>
}

<form method="get">
    <input type="text" name="search" placeholder="Search by Name or Phone" />
    <button type="submit">Search</button>
</form>

<p>
    <a asp-action="Create">Add Patient</a>
</p>

<table border="1" cellpadding="10">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Phone</th>
        <th>Email</th>
        <th>Gender</th>
        <th>Blood Group</th>
        <th>Action</th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Id</td>
            <td>@p.Name</td>
            <td>@p.Phone</td>
            <td>@p.Email</td>
            <td>@p.Gender</td>
            <td>@p.BloodGroup</td>

            <td>
                
                <a asp-action="Details" asp-route-id="@p.Id">Details</a> |

                <a asp-action="Edit" asp-route-id="@p.Id">Edit</a> |

                <a asp-action="Delete" asp-route-id="@p.Id">Delete</a>
            </td>
        </tr>
    }
</table>