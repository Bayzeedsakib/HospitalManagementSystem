@model List<BLL.DTOs.AppointmentDTO>

@{
    ViewData["Title"] = "Appointment List";
}

<h2 class="mb-3">Appointment List</h2>

@if (TempData["Msg"] != null)
{
    <div style="
        background-color:#d4edda;
        color:#155724;
        padding:10px;
        border-radius:5px;
        margin-bottom:15px;">
        @TempData["Msg"]
    </div>
}

<div style="margin-bottom:15px;">

    <a asp-action="Create"
       style="
       background-color:#007bff;
       color:white;
       padding:8px 14px;
       text-decoration:none;
       border-radius:5px;">
        + Create Appointment
    </a>

</div>

<form method="get" style="margin-bottom:20px;">

    <input type="text"
           name="search"
           placeholder="Search Patient / Doctor / Status"
           style="
           padding:8px;
           width:250px;
           border:1px solid #ccc;
           border-radius:5px;" />

    <button type="submit"
            style="
            padding:8px 14px;
            background-color:#28a745;
            color:white;
            border:none;
            border-radius:5px;
            cursor:pointer;">
        Search
    </button>

</form>

<table style="
       width:100%;
       border-collapse:collapse;
       box-shadow:0 2px 8px rgba(0,0,0,0.1);">

    <thead style="background-color:#343a40; color:white;">

        <tr>
            <th style="padding:12px;">ID</th>
            <th>Patient</th>
            <th>Doctor</th>
            <th>Date</th>
            <th>Time</th>
            <th>Serial</th>
            <th>Status</th>
            <th>Action</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var a in Model)
        {
            <tr style="border-bottom:1px solid #ddd;">

                <td style="padding:10px;">@a.Id</td>

                <td>@a.PatientName</td>

                <td>@a.DoctorName</td>

                <td>@a.AppointmentDate</td>

                <td>@a.AppointmentTime</td>

                <td>@a.SerialNo</td>

                <td>
                    <span style="
                          padding:4px 10px;
                          border-radius:12px;
                          background-color:#f0f0f0;">
                        @a.Status
                    </span>
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@a.Id"
                       style="color:#007bff; text-decoration:none;">
                        Details
                    </a>

                    |

                    <a asp-action="Edit"
                       asp-route-id="@a.Id"
                       style="color:#28a745; text-decoration:none;">
                        Edit
                    </a>

                    |

                    <a asp-action="Delete"
                       asp-route-id="@a.Id"
                       style="color:#dc3545; text-decoration:none;">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>