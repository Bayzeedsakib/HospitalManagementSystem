@model BLL.DTOs.AppointmentDTO

<h2>Create Appointment</h2>

@if (TempData["msg"] != null)
{
    <p>@TempData["msg"]</p>
}

<form method="post">

    <p>
        Patient <br />

        <select asp-for="PatientId"
                asp-items="ViewBag.Patients">

            <option value="">Select Patient</option>

        </select>

        <span asp-validation-for="PatientId"></span>
    </p>


    <p>
        Doctor <br />

        <select asp-for="DoctorId"
                asp-items="ViewBag.Doctors">

            <option value="">Select Doctor</option>

        </select>

        <span asp-validation-for="DoctorId"></span>
    </p>


    <p>
        Appointment Date <br />

        <input asp-for="AppointmentDate"
               type="date" />

        <span asp-validation-for="AppointmentDate"></span>
    </p>


    <p>
        Appointment Time <br />

        <input asp-for="AppointmentTime"
               type="time" />

        <span asp-validation-for="AppointmentTime"></span>
    </p>


    <p>
        Status <br />

        <select asp-for="Status">

            @foreach (var s in ViewBag.StatusList)
            {
                <option value="@s">@s</option>
            }

        </select>
    </p>


    <p>
        Problem Description <br />

        <textarea asp-for="ProblemDescription"
                  rows="4"
                  cols="40"></textarea>
    </p>


    <button type="submit">
        Save Appointment
    </button>

</form>