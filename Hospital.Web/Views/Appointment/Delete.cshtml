@model BLL.DTOs.AppointmentDTO

@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="container py-5">
    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="bg-danger bg-gradient text-white text-center p-5">

                    <div class="mb-3">
                        <i class="bi bi-trash-fill display-1"></i>
                    </div>

                    <h2 class="fw-bold mb-2">
                        Delete Appointment
                    </h2>

                    <p class="mb-0 opacity-75">
                        This action cannot be undone
                    </p>

                </div>

                <!-- Body -->
                <div class="card-body p-5 bg-light">

                    <div class="text-center mb-4">

                        <h4 class="fw-bold text-dark">
                            Are you sure you want to delete this appointment?
                        </h4>

                        <p class="text-muted mt-3 mb-0">
                            You are about to remove the appointment for
                        </p>

                        <div class="mt-3">

                            <span class="badge bg-primary fs-6 px-4 py-3 rounded-pill shadow-sm">
                                <i class="bi bi-person-fill me-2"></i>
                                @Model.PatientName
                            </span>

                        </div>

                    </div>

                    <!-- Appointment Info -->
                    <div class="card border-0 shadow-sm rounded-4 mb-4">

                        <div class="card-body">

                            <div class="row text-center">

                                <div class="col-md-6 mb-3 mb-md-0">

                                    <h6 class="text-muted mb-2">
                                        Appointment Date
                                    </h6>

                                    <p class="fw-bold mb-0">
                                        @Model.AppointmentDate
                                    </p>

                                </div>

                                <div class="col-md-6">

                                    <h6 class="text-muted mb-2">
                                        Appointment Time
                                    </h6>

                                    <p class="fw-bold mb-0">
                                        @Model.AppointmentTime
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Buttons -->
                    <form method="post">

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <div class="d-flex justify-content-center gap-3">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary btn-lg rounded-3 px-4">

                                <i class="bi bi-arrow-left me-2"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    name="Decision"
                                    value="Yes"
                                    class="btn btn-danger btn-lg rounded-3 px-5 shadow">

                                <i class="bi bi-trash3-fill me-2"></i>
                                Delete

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
</div>

<style>

    body {
        background: #f5f7fb;
    }

    .card {
        transition: 0.3s ease;
    }

        .card:hover {
            transform: translateY(-2px);
        }

</style>