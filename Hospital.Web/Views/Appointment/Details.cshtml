@model BLL.DTOs.AppointmentDTO

<h2>Appointment Details</h2>

<table border="1" cellpadding="10">

    <tr>
        <th>ID</th>
        <td>@Model.Id</td>
    </tr>

    <tr>
        <th>Patient</th>
        <td>@Model.PatientName</td>
    </tr>

    <tr>
        <th>Doctor</th>
        <td>@Model.DoctorName</td>
    </tr>

    <tr>
        <th>Date</th>
        <td>@Model.AppointmentDate</td>
    </tr>

    <tr>
        <th>Time</th>
        <td>@Model.AppointmentTime</td>
    </tr>

    <tr>
        <th>Serial No</th>
        <td>@Model.SerialNo</td>
    </tr>

    <tr>
        <th>Status</th>
        <td>@Model.Status</td>
    </tr>

    <tr>
        <th>Problem</th>
        <td>@Model.ProblemDescription</td>
    </tr>

    <tr>
        <th>Created At</th>
        <td>@Model.CreatedAt</td>
    </tr>

</table>

<br />

<a asp-action="Index">
    Back to List
</a>