@model BLL.DTOs.PrescriptionDTO

<h2>Prescription Details</h2>

<table border="1" cellpadding="10">

    <tr>
        <th>ID</th>
        <td>@Model.Id</td>
    </tr>

    <tr>
        <th>Patient</th>
        <td>@Model.PatientName</td>
    </tr>

    <tr>
        <th>Doctor</th>
        <td>@Model.DoctorName</td>
    </tr>

    @* <tr> *@
    @*     <th>Appointment Date</th> *@
    @*     <td>@Model.AppointmentDate</td> *@
    @* </tr> *@

    <tr>
        <th>Symptoms</th>
        <td>@Model.Symptoms</td>
    </tr>

    <tr>
        <th>Diagnosis</th>
        <td>@Model.Diagnosis</td>
    </tr>

    <tr>
        <th>Advice</th>
        <td>@Model.Advice</td>
    </tr>

    <tr>
        <th>Next Visit</th>
        <td>@Model.NextVisitDate</td>
    </tr>

    <tr>
        <th>Created At</th>
        <td>@Model.CreatedAt</td>
    </tr>

</table>

<br />

