@model BLL.DTOs.PrescriptionDTO

@{
    ViewData["Title"] = "Prescription Details";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-body">

            <h2 class="mb-4">Prescription Details</h2>

            <table class="table table-bordered">

                <tr>
                    <th>ID</th>
                    <td>@Model.Id</td>
                </tr>

                <tr>
                    <th>Patient</th>
                    <td>@Model.PatientName</td>
                </tr>

                <tr>
                    <th>Doctor</th>
                    <td>@Model.DoctorName</td>
                </tr>

                <tr>
                    <th>Symptoms</th>
                    <td>@Model.Symptoms</td>
                </tr>

                <tr>
                    <th>Diagnosis</th>
                    <td>@Model.Diagnosis</td>
                </tr>

                <tr>
                    <th>Advice</th>
                    <td>@Model.Advice</td>
                </tr>

                <tr>
                    <th>Next Visit</th>
                    <td>@Model.NextVisitDate</td>
                </tr>

                <tr>
                    <th>Created At</th>
                    <td>@Model.CreatedAt</td>
                </tr>

            </table>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-secondary">
                    Back to List
                </a>
            </div>

        </div>

    </div>

</div>