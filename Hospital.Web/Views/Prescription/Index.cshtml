@model List<BLL.DTOs.PrescriptionDTO>

<h2>Prescription List</h2>

<a asp-action="Create">Create New Prescription</a>

<br />
<br />

<form method="get">
    <input type="text" name="search" placeholder="Search patient or doctor" />
    <button type="submit">Search</button>
</form>

<br />

<table border="1">
    <tr>
        <th>Patient</th>
        <th>Doctor</th>
        <th>Symptoms</th>
        <th>Diagnosis</th>
        <th>Advice</th>
        <th>Next Visit</th>
        <th>Created At</th>
        <th>Action</th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.PatientName</td>
            <td>@p.DoctorName</td>
            <td>@p.Symptoms</td>
            <td>@p.Diagnosis</td>
            <td>@p.Advice</td>
            <td>@p.NextVisitDate</td>
            <td>@p.CreatedAt</td>
            <td>
                <a asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                <a asp-action="Delete" asp-route-id="@p.Id">Delete</a>
            </td>
        </tr>
    }
</table>