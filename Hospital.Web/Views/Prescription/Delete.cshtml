@model BLL.DTOs.PrescriptionDTO

@{
    ViewData["Title"] = "Delete Prescription";
}

<div class="container mt-5">

    <div class="card shadow-sm border-0">

        <div class="card-body text-center">

            <h2 class="text-danger mb-3">Delete Prescription</h2>

            <p class="mb-2">Are you sure you want to delete this prescription?</p>

            <h5 class="mb-4 text-dark">
                Appointment ID: @Model.AppointmentId
            </h5>

            <form method="post" class="d-flex justify-content-center gap-3">

                <input type="hidden" name="id" value="@Model.Id" />

                <button type="submit"
                        name="Decision"
                        value="Yes"
                        class="btn btn-danger">
                    Yes, Delete
                </button>

                <button type="submit"
                        name="Decision"
                        value="No"
                        class="btn btn-secondary">
                    Cancel
                </button>

            </form>

        </div>

    </div>

</div>