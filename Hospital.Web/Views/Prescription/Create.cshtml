@model BLL.DTOs.PrescriptionDTO

@{
    ViewData["Title"] = "Create Prescription";
}

<div class="container mt-4">

    <div class="card shadow-sm">
        <div class="card-body">

            <h2 class="mb-4">Create Prescription</h2>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Message
                </div>
            }

            <form method="post">

                <div class="mb-3">
                    <label class="form-label">Appointment</label>
                    <select asp-for="AppointmentId"
                            asp-items="ViewBag.Appointments"
                            class="form-select">
                        <option value="">Select Appointment</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Symptoms" class="form-label"></label>
                    <textarea asp-for="Symptoms" class="form-control" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Diagnosis" class="form-label"></label>
                    <textarea asp-for="Diagnosis" class="form-control" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Advice" class="form-label"></label>
                    <textarea asp-for="Advice" class="form-control" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="NextVisitDate" class="form-label"></label>
                    <input asp-for="NextVisitDate" type="date" class="form-control" />
                </div>

                <button type="submit" class="btn btn-success">
                    Save Prescription
                </button>

                <a asp-action="Index" class="btn btn-secondary ms-2">
                    Back to List
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}